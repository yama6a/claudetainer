{
  "cleanupPeriodDays": 365,
  "crossSessionInbound": "accept",
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/claudetainer/worktree-create.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/lib/claudetainer/session-start.sh"
          }
        ]
      }
    ]
  }
}
